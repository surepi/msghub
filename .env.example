# 管理后台登录密码（必填）
ADMIN_PASSWORD=change-me

# 本机 MySQL / MariaDB。填写给 MsgHub 单独创建的数据库和账号。
DB_NAME=msghub
DB_USER=msghub
DB_PASSWORD=
# Compose 通过 mariadb-shared 网络上的 mysql:3306 连接共享 MariaDB。

# 令牌签名密钥。留空则自动生成并保存到 ./data/.secret
SECRET_KEY=

# 监听地址与端口
BIND_ADDR=127.0.0.1
HOST_PORT=20100
# 可信反代连接到容器时的实际来源地址，Docker 部署见 docs/SECURITY-DEPLOYMENT.md
FORWARDED_ALLOW_IPS=127.0.0.1

# 公开提交接口：每个 IP 每分钟最多提交条数
RATE_LIMIT_PER_MIN=5
AI_CALLS_PER_HOUR=120

TZ=Asia/Shanghai

# QQ 官方机器人（q.qq.com → 开发设置）。不填则只能在网页后台回复
QQ_APP_ID=
QQ_APP_SECRET=
# 使用独立随机值，至少 32 个 URL 安全字符，配置后需在 QQ 平台更新回调地址
QQ_CALLBACK_KEY=
QQ_CALLBACK_MAX_AGE=300
